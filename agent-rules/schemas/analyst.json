{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "analyst",
  "description": "Tahlilchi agentining bitta bob uchun javobi. `book`, `rulesVersion`, `chapters`, `index`, `title` tizim tomonidan qo'shiladi.",
  "type": "object",
  "required": ["keyIdeas", "terms"],
  "properties": {
    "keyIdeas": {
      "type": "array",
      "description": "Bobning eng muhim g'oyalari (3-5; g'oya yo'qsa bo'sh massiv).",
      "minItems": 0,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["id", "idea", "why", "howToApply"],
        "properties": {
          "id": {
            "type": "string",
            "description": "Bo'sh satr qoldiring: tizim `ch<n>-i<m>` ni o'zi beradi."
          },
          "idea": { "type": "string", "minLength": 1, "description": "G'oya — 1-2 gap" },
          "why": { "type": "string", "minLength": 1, "description": "Nima uchun muhim (matndagi sabab)" },
          "howToApply": {
            "type": "string",
            "minLength": 1,
            "description": "Aniq BIRINCHI qadam (foydalanuvchi ertaga bajaradigan)"
          },
          "applyTags": {
            "type": "array",
            "maxItems": 2,
            "items": {
              "type": "string",
              "enum": ["ish", "oila", "do'stlik", "o'qish", "shaxsiy"]
            },
            "description": "ish | oila | do'stlik | o'qish | shaxsiy"
          }
        },
        "additionalProperties": false
      }
    },
    "terms": {
      "type": "array",
      "description": "Bobdagi murakkab atamalar (2-6; yo'qsa bo'sh massiv).",
      "minItems": 0,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": ["term", "definitionSimple"],
        "properties": {
          "term": { "type": "string", "minLength": 1 },
          "definitionSimple": { "type": "string", "minLength": 1, "description": "Oddiy tilda — 1-2 gap" },
          "metaphor": { "type": "string", "description": "Tushunarli metafora (ixtiyoriy)" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
