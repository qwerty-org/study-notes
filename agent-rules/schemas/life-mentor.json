{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "life-mentor",
  "type": "object",
  "required": ["scenarios"],
  "properties": {
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "maxItems": 15,
      "items": {
        "type": "object",
        "required": ["id", "ideaId", "situation", "rightAction", "wrongAction"],
        "properties": {
          "id": { "type": "string" },
          "ideaId": { "type": "string", "description": "Bog'langan g'oya id si" },
          "situation": { "type": "string", "description": "Real vaziyat — 2-3 gap" },
          "rightAction": { "type": "string", "description": "Aniq gap yoki qadam" },
          "wrongAction": { "type": "string", "description": "Ko'pchilik qiladigan xato" },
          "whyWrong": { "type": "string", "description": "Xatoning oqibati" },
          "context": { "enum": ["ish", "oila", "do'stlik", "o'qish", "shaxsiy"] }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
